{
  "expo": {
    "name": "VOCALink-Mobile",
    "slug": "VOCALink-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vocalinkmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lacsyy.VOCALinkMobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00AEEF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lacsyy.VOCALinkMobile"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class expo.modules.core.interfaces.** { *; }\n-keep class expo.modules.kotlin.types.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10cb986a-f6da-4484-8b4b-b9f122d3431f"
      }
    }
  }
}
